# ===== Claude (bộ não của nhân viên gọi điện) =====
# Không có key -> app vẫn chạy với "luật dự phòng" (nhận diện từ khoá đơn giản).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low            # low = phản hồi nhanh, phù hợp nói chuyện điện thoại
CLAUDE_TIMEOUT_MS=9000       # quá thời gian -> tự dùng luật dự phòng để không im lặng trên máy

# ===== Twilio (gọi điện thật) =====
# Bỏ trống -> chế độ giả lập: cuộc gọi hiện lên trên giao diện web.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1xxxxxxxxxx   # số Twilio có quyền gọi quốc tế tới Việt Nam
PUBLIC_BASE_URL=https://xxxx.ngrok-free.app   # URL công khai trỏ về server này
TTS_VOICE=Google.vi-VN-Wavenet-A
TWILIO_AMD=on                # phát hiện hộp thư thoại (off để tắt)
TWILIO_VALIDATE=on           # kiểm tra chữ ký webhook

# ===== Nhân viên & lịch gọi =====
AGENT_NAME=Thu Hà
CLINIC_NAME=MedCall
MAX_ATTEMPTS=3               # số lần gọi tối đa khi không nghe máy
RETRY_MINUTES=10             # gọi lại sau bao nhiêu phút
MAX_SNOOZES=3                # số lần được hẹn "lát nữa gọi lại"

# ===== Khác =====
PORT=3000
ADMIN_PASSWORD=              # đặt mật khẩu để bảo vệ trang quản trị
